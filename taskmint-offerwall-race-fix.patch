+  world.txs.push({ _id: 'orig', userId: 'u1', externalId: 'cpx:txn-1', transactionType: 'offer_reward', amount: 500, status: 'completed' });
+
+  const result = await reverseLegacyOfferTransaction(reverseArgs(world));
